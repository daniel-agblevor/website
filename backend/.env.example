# Security Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-in-production

# Supabase Postgres Database URL
# Note: Format postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>

# Supabase Auth Settings
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email Provider Configuration (Resend API key, or BREVO_API_KEY)
RESEND_API_KEY=re_1234567890abcdef
NOTIFICATION_EMAIL_TO=consultant@example.com
NOTIFICATION_EMAIL_FROM=onboarding@resend.dev

# CORS & Deployment Configuration
FRONTEND_URL=https://yourusername.github.io
ADMIN_ROUTE_PATH=/admin-portal-secret-slug

# Environment (development / production)
FLASK_ENV=development
